---
import LegalLayout from '../../layouts/LegalLayout.astro';
import { legalConfig } from '../../config/legal.js';

const sections = [
  {
    title: 'J-Cloud’s role under Nigerian law',
    paragraphs: [
      'J-Cloud operates the online control backend for accounts, device registration and subscriptions. Your file contents remain on your Windows computer; J-Cloud does not host them. J-Cloud may act as a data controller or data processor depending on the activity, as further described in the Privacy Policy.',
    ],
  },
  {
    title: 'Nigeria Data Protection Act 2023',
    paragraphs: [
      'J-Cloud is designed to be consistent with the Nigeria Data Protection Act 2023, including lawful bases for processing, data subject rights, security obligations and breach response. This document is a draft and does not by itself establish compliance.',
    ],
  },
  {
    title: 'Security of processing',
    items: [
      'Authentication credentials are hashed and stored securely.',
      'Sessions and pairing are enforced laptop-side.',
      'Devices can be revoked through the online backend.',
      'Access to service systems is restricted to authorized personnel.',
    ],
  },
  {
    title: 'Data subject rights',
    paragraphs: [
      'You may request access, correction, erasure, restriction or portability of your personal data, and may object to processing or withdraw consent where applicable.',
    ],
  },
  {
    title: 'Contact',
    paragraphs: [
      `Data-protection requests should be sent to ${legalConfig.privacyEmail}. Until this field is configured, use the support page instructions and do not publish this document.`,
    ],
  },
];

export const prerender = true;
---
<LegalLayout title="Data Protection Notice" description="J-Cloud’s role and responsibilities under Nigerian data-protection law." sections={sections} />