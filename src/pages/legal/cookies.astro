---
import LegalLayout from '../../layouts/LegalLayout.astro';
import { legalConfig } from '../../config/legal.js';

const sections = [
  {
    title: 'Cookies on the public website',
    paragraphs: [
      'The J-Cloud public website uses cookies and similar technologies to operate, remember preferences and analyze usage. This Cookie Policy explains what we use and your choices.',
    ],
  },
  {
    title: 'Types of cookies',
    items: [
      'Strictly necessary cookies: required for the website to function (navigation, security, accessibility).',
      'Performance/analytics cookies: help us understand how visitors use the site so we can improve it.',
      'Preference cookies: remember your settings such as language or layout.',
    ],
  },
  {
    title: 'Your choices',
    paragraphs: [
      'You may accept or decline non-essential cookies through your browser settings. Declining some cookies may affect how parts of the website work.',
    ],
  },
  {
    title: 'Contact',
    paragraphs: [
      `Questions should be sent to ${legalConfig.supportEmail}. Until this field is configured, use the support page instructions and do not publish this document.`,
    ],
  },
];

export const prerender = true;
---
<LegalLayout title="Cookie Policy" description="Cookies and similar technologies used by the public website." sections={sections} />