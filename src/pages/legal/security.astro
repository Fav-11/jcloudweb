---
import LegalLayout from '../../layouts/LegalLayout.astro';
import { legalConfig } from '../../config/legal.js';

const sections = [
  {
    title: 'Security posture',
    paragraphs: [
      'J-Cloud takes the security of your account, devices and the service seriously. Because your files remain on your Windows computer, much of the security boundary is on your machine and local network.',
    ],
  },
  {
    title: 'Security measures',
    items: [
      'Hashed authentication credentials.',
      'Laptop-side session and pairing enforcement.',
      'Device registration and revocation through the online backend.',
      'Encrypted connections between the app, laptop server and backend.',
      'Premium remote connectivity via the J-Cloud relay, with Cloudflare Quick Tunnel as a fallback.',
    ],
  },
  {
    title: 'Reporting a vulnerability',
    paragraphs: [
      'If you believe you have found a security vulnerability, please report it responsibly. Do not attempt to access data you are not authorized to see, and do not publicly disclose the issue before J-Cloud has had a reasonable opportunity to investigate.',
    ],
  },
  {
    title: 'How to report',
    paragraphs: [
      `Send reports to ${legalConfig.securityEmail}. Include a clear description, steps to reproduce, and any relevant logs or screenshots. J-Cloud will acknowledge receipt and provide an estimated timeline for investigation. Until this field is configured, use the support page instructions and do not publish this document.`,
    ],
  },
  {
    title: 'Scope',
    items: [
      'Accounts, devices and subscription data managed by the online backend.',
      'The J-Cloud relay and connectivity infrastructure.',
      'Not the files on your own Windows computer — you control those.',
    ],
  },
];

export const prerender = true;
---
<LegalLayout title="Security & Vulnerability Disclosure" description="How to report security concerns and receive a response." sections={sections} />