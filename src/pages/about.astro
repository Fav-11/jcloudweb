---
import MainLayout from '../layouts/MainLayout.astro';
import { siteConfig } from '../config/site.js';
import { Laptop, Smartphone, Cloud, GitBranch, ShieldCheck } from '@lucide/astro';
---

<MainLayout title="About J-Cloud" description="About J-Cloud personal file access: Windows laptop server, Flutter Android app, and online control backend.">
  <section class="section" style="padding-top: 40px;">
    <div class="container narrow" data-reveal>
      <p class="eyebrow">About</p>
      <h1>About J-Cloud</h1>
      <p style="color: var(--text-muted); font-size: 1.1rem; margin-bottom: 2rem;">J-Cloud is personal cloud storage and remote file access. Your own Windows computer is the storage source — your files stay on your machine, not in someone else’s data centre.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;" data-reveal>
        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem;">
          <div style="width: 44px; height: 44px; border-radius: var(--radius-sm); background: var(--surface-2); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; color: var(--accent); margin-bottom: 1rem;"><Laptop size={22} aria-hidden="true" /></div>
          <h2 style="font-size: 1.1rem; margin-bottom: 0.5rem;">Windows laptop server</h2>
          <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">A Python FastAPI server you install on Windows. It reaches your local files and handles browsing, transfers, pairing and sessions.</p>
        </div>
        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem;">
          <div style="width: 44px; height: 44px; border-radius: var(--radius-sm); background: var(--surface-2); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; color: var(--accent); margin-bottom: 1rem;"><Smartphone size={22} aria-hidden="true" /></div>
          <h2 style="font-size: 1.1rem; margin-bottom: 0.5rem;">Flutter mobile app</h2>
          <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">The Android interface for browsing and managing your paired laptop’s files, over LAN or remotely (Premium).</p>
        </div>
        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem;">
          <div style="width: 44px; height: 44px; border-radius: var(--radius-sm); background: var(--surface-2); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; color: var(--accent); margin-bottom: 1rem;"><Cloud size={22} aria-hidden="true" /></div>
          <h2 style="font-size: 1.1rem; margin-bottom: 0.5rem;">Online control backend</h2>
          <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">Accounts, device registration, subscriptions, payments and remote-access authorization. Stores metadata, never your file contents.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem;" data-reveal>
        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem;">
          <div>
            <h2 style="font-size: 1.1rem; margin-bottom: 0.75rem;">What J-Cloud is not</h2>
            <ul style="color: var(--text-muted); font-size: 0.9rem; padding-left: 1.1rem; margin: 0;">
              <li style="margin-bottom: 0.5rem;">Not a file-hosting service.</li>
              <li style="margin-bottom: 0.5rem;">Not a replacement for your laptop.</li>
              <li style="margin-bottom: 0;">Not a general cloud storage provider.</li>
            </ul>
          </div>
          <div>
            <h2 style="font-size: 1.1rem; margin-bottom: 0.75rem;">Architecture principles</h2>
            <ul style="color: var(--text-muted); font-size: 0.9rem; padding-left: 1.1rem; margin: 0;">
              <li style="margin-bottom: 0.5rem;">You own and control the storage.</li>
              <li style="margin-bottom: 0.5rem;">Remote access is optional and Premium-only.</li>
              <li style="margin-bottom: 0;">The relay moves traffic, not files.</li>
            </ul>
          </div>
        </div>
        <p style="color: var(--text-dim); font-size: 0.85rem; margin-top: 1rem;">J-Cloud, the J-Cloud mark and the Windows Server are product names of the J-Cloud project. Legal operator details are configured in src/config/legal.js and must be completed before publication.</p>
      </div>
    </div>
  </section>
</MainLayout>