---
const { icon: Icon, title, description, href, label = 'Learn more' } = Astro.props;
---
<article class="feature-card" data-reveal>
  <div class="feature-icon"><Icon size={21} strokeWidth={1.8} aria-hidden="true" /></div>
  <h3>{title}</h3>
  <p>{description}</p>
  {href && <a class="text-link" href={href}>{label}<span aria-hidden="true"> →</span></a>}
</article>
