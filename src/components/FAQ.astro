---
const { items, heading = 'Frequently asked questions', intro } = Astro.props;
---
<section class="section faq-section">
  <div class="container narrow">
    <div class="section-heading centered" data-reveal>
      <p class="eyebrow">Questions, answered</p>
      <h2>{heading}</h2>
      {intro && <p>{intro}</p>}
    </div>
    <div class="faq-list" data-reveal>
      {items.map((item: { question: string; answer: string }) => (
        <details class="faq-item">
          <summary><span>{item.question}</span><span class="faq-plus" aria-hidden="true"></span></summary>
          <div class="faq-answer"><p>{item.answer}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
